require "json"

default_platform(:ios)

APP_IDENTIFIER = "com.justinstrong.AudioControl"
APP_NAME = "AudioControl"
APP_VERSION = "1.0.0"
APP_SKU = "AUDIOCONTROL-IOS-1"
TEAM_ID = "3TKP8A48MF"
IPA_PATH = "build/AudioControl.ipa"

def load_api_key
  config_path = ENV.fetch("ASC_API_KEY_JSON") do
    UI.user_error!("Set ASC_API_KEY_JSON to an untracked App Store Connect API-key JSON file")
  end

  config_path = File.expand_path(config_path)
  config = JSON.parse(File.read(config_path))
  key_path = File.expand_path(
    File.basename(config.fetch("key_filepath")),
    File.dirname(config_path)
  )

  app_store_connect_api_key(
    key_id: config.fetch("key_id"),
    issuer_id: config.fetch("issuer_id"),
    key_filepath: key_path
  )
end

def review_information
  directory = ENV.fetch("APP_REVIEW_INFO_DIR") do
    UI.user_error!("Set APP_REVIEW_INFO_DIR to an untracked directory containing App Review contact files")
  end

  read = lambda do |name|
    File.read(File.join(directory, "#{name}.txt")).strip
  end

  {
    first_name: read.call("first_name"),
    last_name: read.call("last_name"),
    phone_number: read.call("phone_number"),
    email_address: read.call("email_address"),
    notes: File.read("fastlane/metadata/review_information/notes.txt").strip
  }
end

def build_release
  build_app(
    project: "ios/AudioControl.xcodeproj",
    scheme: "AudioControl",
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    output_directory: "build",
    output_name: "AudioControl.ipa",
    xcargs: "-allowProvisioningUpdates",
    export_options: {
      signingStyle: "automatic",
      teamID: TEAM_ID,
      uploadSymbols: true
    }
  )
end

def upload_metadata(api_key:, submit_for_review:)
  options = {
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    app_version: APP_VERSION,
    platform: "ios",
    metadata_path: "fastlane/metadata",
    screenshots_path: "fastlane/screenshots",
    app_rating_config_path: "fastlane/app_rating_config.json",
    skip_binary_upload: true,
    skip_metadata: false,
    skip_screenshots: false,
    submit_for_review: submit_for_review,
    automatic_release: true,
    force: true,
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: true,
    submission_information: {
      add_id_info_uses_idfa: false,
      export_compliance_uses_encryption: false,
      content_rights_contains_third_party_content: false
    }
  }
  options[:app_review_information] = review_information if submit_for_review

  upload_to_app_store(**options)
end

platform :ios do
  desc "Create the first App Store Connect record (interactive Apple Account authentication)"
  lane :create_app_record do
    create_app_online(
      username: ENV.fetch("APPLE_ID"),
      app_identifier: APP_IDENTIFIER,
      app_name: APP_NAME,
      app_version: APP_VERSION,
      sku: APP_SKU,
      platform: "ios",
      language: "en-US",
      skip_devcenter: true
    )
  end

  desc "Run the portable Swift test suite"
  lane :test do
    sh("cd ios && swift test")
  end

  desc "Build a signed App Store IPA without uploading it"
  lane :build do
    load_api_key
    build_release
  end

  desc "Build and upload to TestFlight without submitting for review"
  lane :beta do
    api_key = load_api_key
    ensure_git_status_clean
    build_release

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: IPA_PATH,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload editable App Store metadata and screenshots"
  lane :metadata do
    api_key = load_api_key
    upload_metadata(api_key: api_key, submit_for_review: false)
  end

  desc "Build, upload, and submit version 1.0.0 for automatic release"
  lane :release do
    api_key = load_api_key
    ensure_git_status_clean
    build_release

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: IPA_PATH,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )

    upload_metadata(api_key: api_key, submit_for_review: true)
  end
end
